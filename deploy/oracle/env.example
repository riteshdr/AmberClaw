# AmberClaw production env for the Oracle Always Free VM.
# The setup script copies this to the repo root as .env (chmod 600).

AMBERCLAW_HOST=0.0.0.0
PORT=10000
AMBERCLAW_DATA_DIR=/data
STREAMCLIPS_HOME=/data/StreamClips

# Headless moment picking (required for unattended jobs).
STREAMCLIPS_BRAIN=openai
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Uploads are off by default. Set to true only after mounting client_secrets.json + token.json.
AUTO_UPLOAD=false
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=20

# IMPORTANT: protect the public UI. Format: user:password,user2:password2
AMBERCLAW_BASIC_AUTH=admin:replace-with-a-strong-password

# Only needed for the optional Caddy TLS profile.
DOMAIN=claw.example.com
