# AmberClaw configuration

# Web app
AMBERCLAW_HOST=0.0.0.0
AMBERCLAW_PORT=10000
AMBERCLAW_DATA_DIR=./data
# Comma-separated basic auth credentials "user:pass" (optional but recommended if public)
AMBERCLAW_BASIC_AUTH=

# stream-clips
# Path to stream-clips.py (vendored copy by default)
STREAMCLIPS_PY=vendor/stream-clips/scripts/streamclips.py
# Python executable to run stream-clips with (use the stream-clips venv python after setup)
STREAMCLIPS_PYTHON=python
# Brain/picker: groq (free open-weight, default), agent (not for headless servers), claude, codex, gemini, opencode, openai
STREAMCLIPS_BRAIN=groq
STREAMCLIPS_MODEL=
# Extra default args, e.g. --fast --language en
STREAMCLIPS_EXTRA_ARGS=

# Free/open-weight picker via Groq (used when STREAMCLIPS_BRAIN=groq).
# Get free keys at https://console.groq.com/keys
# Several keys can be comma-separated to rotate across free accounts:
# GROQ_API_KEY=<key1>,<key2>,<key3>
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Optional paid OpenAI-compatible picker (used when STREAMCLIPS_BRAIN=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# YouTube upload (OAuth2 - installed app / refresh token flow)
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=20
# If true, send generated clips to the daily upload queue after each job
AUTO_UPLOAD=false
# Credit template variables: {creator}, {title}, {url}, {caption}, {hashtags}
# {caption} receives a freshly generated Roman Hinglish hype description per short.
YOUTUBE_DESCRIPTION_TEMPLATE={caption}\n\n{hashtags}\n\nCredit: {creator} — {url}\nPurana video dekhne ke liye upar wala source link dabao. Is clip ke saare rights original creator ke paas hain. #GTA6 #GTA5
# At least 15 GTA6 tags are always added to every short (code-enforced).
YOUTUBE_TAGS_DEFAULT=gta6,gta 6,grand theft auto 6,gta vi,grand theft auto vi,gta6 gameplay,gta 6 gameplay,gta6 shorts,gta 6 shorts,gta6 funny,gta 6 funny,gta6 moments,gta 6 moments,gta6 hindi,gta6 hinglish,gta5,gta 5,gta v,grand theft auto v,gta5 shorts,shorts,gaming,viral
YOUTUBE_MIN_TAGS=15
# Free Groq GPT-OSS writes a fresh Roman Hinglish title + description per short.
YOUTUBE_META_BRAIN=groq
YOUTUBE_META_MODEL=openai/gpt-oss-20b

# Daily upload queue / scheduler (free YouTube quota fits ~6 uploads/day)
# queue = enqueue clips and upload a few each quota day; immediate = upload inside the job
UPLOAD_MODE=queue
UPLOAD_SCHEDULER_ENABLED=true
UPLOAD_TICK_MINUTES=10
YOUTUBE_DAILY_UPLOAD_LIMIT=6
# UPLOAD_QUEUE_PATH=<DATA_DIR>/jobs/upload_queue.json
# Set true to exercise the queue without spending YouTube quota
UPLOAD_DRY_RUN=false
